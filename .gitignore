# Local Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log

# .terraform directory - contains Terraform modules and provider plugins
.terraform/

# override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# .terraform.lock.hcl - contains provider lock information
.terraform.lock.hcl

# Environment files (if used to store sensitive data)
*.env

# Terraform plan output files
*.plan

# Sensitive files (e.g., AWS credentials, etc.)
*.tfvars
*.tfvars.json

# Log files
*.log

# IDE and editor-specific files
.vscode/
.idea/
*.swp
*.swo
